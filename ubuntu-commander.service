[Unit]
Description=Ubuntu Commander private MCP tunnel
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/exampleuser/projects/linux-terminal-commander
LoadCredential=runtime-api-key:/home/exampleuser/.config/ubuntu-commander/runtime-api-key
ExecStart=/home/exampleuser/projects/linux-terminal-commander/.venv/bin/python /home/exampleuser/projects/linux-terminal-commander/service_runner.py
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
LimitCORE=0
LimitNOFILE=256
TasksMax=512

[Install]
WantedBy=default.target
